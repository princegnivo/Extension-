{
  "manifest_version": 3,
  "name": "PO Strategy — RSI 5s + Martingale",
  "version": "1.0.0",
  "description": "Assistant de stratégie pour Pocket Option : signaux RSI 5s confirmés par la mèche (Pourcentage d'ombre) + martingale. Outil de mémoire, compte démo recommandé.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.pocketoption.com/*", "https://pocketoption.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PO Strategy"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.pocketoption.com/*", "https://pocketoption.com/*"],
      "js": ["strategy.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["https://*.pocketoption.com/*", "https://pocketoption.com/*"]
    }
  ]
}
